# Copy to keystore.properties and fill in. That file is gitignored: it holds the
# password to the key that signs Play Store uploads.
#
# Create the key first (run from the android/ directory):
#
#   keytool -genkeypair -v \
#     -keystore warrington-parks-upload.jks \
#     -alias warrington-parks \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# keytool will prompt for a password and for your name/organisation. Back the .jks
# file up somewhere durable — a password manager or encrypted drive, not just this
# laptop. With Play App Signing enabled, losing it is recoverable (Google holds the
# real app signing key and you can register a new upload key), but it is still a
# day you would rather not have.

storeFile=warrington-parks-upload.jks
storePassword=
keyAlias=warrington-parks
keyPassword=
