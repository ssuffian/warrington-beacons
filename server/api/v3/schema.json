{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trails.warringtoneac.org/api/v3/schema.json",
  "title": "Warrington Talking Trails API v3",
  "description": "Places keyed by stable recordKey with optional beacon Minor, ordered tour stops that may lack beacons, and optional beacon-free trail start and end points.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "landmarks",
    "locations",
    "trails"
  ],
  "properties": {
    "landmarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/landmark"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "trails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trail"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "coordinates",
        "description",
        "id",
        "imageAlt",
        "imagePath",
        "location",
        "longDescription",
        "name"
      ],
      "properties": {
        "beaconMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Present only when a physical beacon broadcasts this place."
        },
        "category": {
          "type": "string",
          "enum": [
            "Building",
            "PointOfInterest",
            "Trail"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/coordinate"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Stable recordKey shared by the master Sheet and KML."
        },
        "imageAlt": {
          "type": "string"
        },
        "imagePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]"
        },
        "isOpen": {
          "type": "boolean"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "longDescription": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "trailDistanceDescription": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "altBeaconUUID",
        "beaconMajorCode",
        "iBeaconUUID",
        "id",
        "name"
      ],
      "properties": {
        "address": {
          "type": "string"
        },
        "altBeaconUUID": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "beaconMajorCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "iBeaconUUID": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routeCoordinate": {
      "oneOf": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/trailStop"
        }
      ]
    },
    "trail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaryCoordinates",
        "id",
        "isOpen",
        "location",
        "name",
        "trailDistanceDescription"
      ],
      "properties": {
        "boundaryCoordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeCoordinate"
          }
        },
        "end": {
          "$ref": "#/$defs/trailEndpoint"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "isOpen": {
          "type": "boolean"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/trailEndpoint"
        },
        "trailDistanceDescription": {
          "type": "string"
        }
      }
    },
    "trailEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "description": "A beacon-free trail start or end. distance and directions lead toward the adjacent tour stop.",
      "required": [
        "directions",
        "distance",
        "latitude",
        "longitude"
      ],
      "properties": {
        "directions": {
          "type": "string"
        },
        "distance": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "trailStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distanceToNextClockwise",
        "distanceToNextClockwiseDescription",
        "distanceToNextCounterClockwise",
        "distanceToNextCounterClockwiseDescription",
        "landmarkId",
        "latitude",
        "longitude"
      ],
      "properties": {
        "distanceToNextClockwise": {
          "type": "string"
        },
        "distanceToNextClockwiseDescription": {
          "type": "string"
        },
        "distanceToNextCounterClockwise": {
          "type": "string"
        },
        "distanceToNextCounterClockwiseDescription": {
          "type": "string"
        },
        "landmarkId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  },
  "x-invariants": [
    "Location IDs are unique.",
    "Landmark IDs are unique.",
    "Landmark beaconMinor values are unique.",
    "Trail IDs are unique.",
    "Every landmark and trail location references an existing location ID.",
    "Every boundaryCoordinates landmarkId references an existing landmark ID.",
    "Within a trail, boundaryCoordinates lists tour stops in tour order; start precedes the first stop and end follows the last."
  ]
}
